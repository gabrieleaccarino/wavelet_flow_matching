#!/bin/bash -l
# ============================================================================
# IC-perturbation inference — ONE job = one (SEED, IC_NOISE) point.
#
# The job name and log paths are set at submit time (they can't use runtime
# shell vars inside #PBS directives), so submit with -N/-o/-e/-v, e.g.:
#
#   qsub -N WaveletFlow_turbulent_radiative_layer_2D_3scales_haar_v4.0_ic0p050_seed42 \
#        -o .../WaveletFlow_turbulent_radiative_layer_2D_3scales_haar_v4.0_ic0p050_seed42.out \
#        -e .../WaveletFlow_turbulent_radiative_layer_2D_3scales_haar_v4.0_ic0p050_seed42.err \
#        -v SEED=42,IC_NOISE=0.05 \
#        inference_ic_pert.pbs
#
# or just use submit_ic_grid.sh, which fills all of that in for a whole sweep.
# Running it directly (qsub inference_ic_pert.pbs) uses the defaults below.
# ============================================================================

# === Project / Queue ===
#PBS -A UCLB0062
#PBS -q main

# === Resources ===
#PBS -l select=1:ncpus=64:mpiprocs=4:ngpus=4:gpu_type=a100:mem=400GB
#PBS -l walltime=01:00:00

# === Default job name / logs (override with qsub -N/-o/-e) ===
#PBS -N WaveletFlow_turbulent_radiative_layer_2D_3scales_haar_v4.0_ic_pert

# === Move to submission directory ===
cd $PBS_O_WORKDIR

# ── Parameters (override at submit time: qsub -v SEED=42,IC_NOISE=0.05 ...) ──
SEED=${SEED:-42}
IC_NOISE=${IC_NOISE:-0.0}
IC_TAG="ic${IC_NOISE//./p}"          # 0.05 -> ic0p05
RUN_TAG="seed${SEED}_${IC_TAG}"

DATASET_NAME="turbulent_radiative_layer_2D"
REPO=/glade/work/gaccarino/waveletflux
CONFIG=${REPO}/configs/${DATASET_NAME}/inference_${DATASET_NAME}_seed.yaml
N_GPUS=4
N_ENSEMBLE=8
NUM_SAMPLING=50
ODE_METHOD="euler"
CLAMP_SIGMA=5.0

export NCCL_DEBUG=INFO
export NCCL_IB_DISABLE=1
export NCCL_P2P_DISABLE=0
export NCCL_SHM_DISABLE=0
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1

conda activate mlenv

echo "========================================================"
echo "  Job ID      : ${PBS_JOBID}"
echo "  Job name    : ${PBS_JOBNAME}"
echo "  Node list   : $(cat ${PBS_NODEFILE} | tr '\n' ' ')"
echo "  GPUs        : ${N_GPUS}"
echo "  Config      : ${CONFIG}"
echo "  SEED        : ${SEED}"
echo "  IC_NOISE    : ${IC_NOISE}   (0.0 = unperturbed baseline)"
echo "  N_ENSEMBLE  : ${N_ENSEMBLE}"
echo "  NUM_SAMPLING: ${NUM_SAMPLING}"
echo "  ODE_METHOD  : ${ODE_METHOD}"
echo "  CLAMP_SIGMA : ${CLAMP_SIGMA}"
echo "  Started     : $(date)"
echo "========================================================"

torchrun \
  --nproc_per_node=${N_GPUS} \
  ${REPO}/waveletflux/inference_wavelet_fm_ic_pert.py \
  --config ${CONFIG} \
  --override \
  n_ensemble=${N_ENSEMBLE} \
  num_sampling_steps=${NUM_SAMPLING} \
  ode_method=${ODE_METHOD} \
  clamp_sigma=${CLAMP_SIGMA} \
  seed=${SEED} \
  ic_noise=${IC_NOISE} \
  run_tag=${RUN_TAG}

EXIT_CODE=$?

echo "========================================================"
echo "  Finished : $(date)"
echo "  Exit code: ${EXIT_CODE}"
echo "========================================================"
exit ${EXIT_CODE}
